# ====================
# Local Development
# ====================

# Frontend (used at build time by CRA)
REACT_APP_API_URL=http://localhost:8080
REACT_APP_YOUTUBE_API_KEY=your_youtube_api_key
REACT_APP_YOUTUBE_CHANNEL_ID=your_channel_id
REACT_APP_ADMIN_EMAIL=admin@example.com
REACT_APP_ADMIN_PASSWORD=change_me
REACT_APP_ADMIN_NAME=Admin

# Backend (used at runtime by docker-compose)
JWT_SECRET=change-me-to-a-random-base64-secret
DB_PASSWORD=church_pass

# ====================
# Production (DigitalOcean Droplet)
# ====================
# These are set in /opt/church-website-fhbck/.env by the deploy workflow
# JWT_SECRET       = openssl rand -base64 32
# DB_PASSWORD      = openssl rand -base64 18
#
# GitHub secrets required:
#   DO_HOST            - Droplet IP
#   DO_USER            - root
#   DO_SSH_KEY         - SSH private key
#   DOMAIN             - your domain (e.g. fhbck.org)
#   JWT_SECRET         - JWT signing secret
#   DB_PASSWORD        - Postgres password
#   YOUTUBE_API_KEY    - YouTube Data API key
#   YOUTUBE_CHANNEL_ID - YouTube channel ID
#   ADMIN_EMAIL        - Admin login email (frontend fallback auth)
#   ADMIN_PASSWORD     - Admin login password
#   ADMIN_NAME         - Admin display name
#   MAIL_HOST          - SMTP host (optional)
#   MAIL_USERNAME      - SMTP username (optional)
#   MAIL_PASSWORD      - SMTP password (optional)
#   MAIL_NOTIFY_TO     - Contact form recipient (optional)
